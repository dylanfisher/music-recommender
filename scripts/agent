#!/usr/bin/env bash
# The launch agent: runs `music-recommender serve` at login and restarts it if it exits with
# an error, at most once a minute (KeepAlive SuccessfulExit=false, ThrottleInterval 60), so a
# bad config doesn't loop. The owner runs this; nothing in the build or tests does.
#   ./scripts/agent install     build a release binary, copy it to the bin directory below,
#                               write the plist to ~/Library/LaunchAgents and load it (again,
#                               if loaded)
#   ./scripts/agent uninstall   unload it and remove the plist
#   ./scripts/agent status      launchd's view of it
#   ./scripts/agent plist       print the plist install would write, and change nothing
#
# The binary is copied to ~/Library/Application Support/music-recommender/bin, so a rebuild or
# `cargo clean` in the repo doesn't change what the agent runs; serve's output goes to
# ~/Library/Logs/music-recommender/serve.log.
#
# install signs the binary with the self-signed certificate below under a fixed identifier
# (ADR 0015). macOS keys the agent's network-volumes permission to the signature, and an
# ad-hoc signature changes with every build, so each install would ask again on mbp2021's
# screen and block the stager until someone answered. Create the certificate once in
# Keychain Access (Certificate Assistant, type Code Signing) and let codesign use its key.
set -euo pipefail
cd "$(dirname "$0")/.."

label=local.music-recommender
plist_path="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"
bin_dir="$HOME/Library/Application Support/music-recommender/bin"
binary="$bin_dir/music-recommender"
log_dir="$HOME/Library/Logs/music-recommender"
log_file="$log_dir/serve.log"
signing_identity="music-recommender local"
signing_identifier="$label"

# Fails before the build when the certificate is missing: an ad-hoc binary would lose the
# network-volumes permission. Untrusted is fine; codesign needs the key, not trust.
require_identity() {
  if ! security find-identity -p codesigning | grep -qF "\"$signing_identity\""; then
    echo "no code-signing certificate \"$signing_identity\" in the keychain; create it in" >&2
    echo "Keychain Access (Certificate Assistant, type Code Signing), then install again" >&2
    exit 1
  fi
}

# plist <binary> <log file>
plist() {
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$1</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$2</string>
  <key>StandardErrorPath</key>
  <string>$2</string>
</dict>
</plist>
EOF
}

loaded() { launchctl print "$domain/$label" >/dev/null 2>&1; }

# Unloads the agent and waits, up to 10 s, until launchd no longer lists it: bootout
# returns before it has finished, and a bootstrap right after can fail.
unload() {
  launchctl bootout "$domain/$label"
  for _ in $(seq 20); do
    loaded || return 0
    sleep 0.5
  done
  echo "$label is still loaded 10 s after bootout" >&2
  return 1
}

case "${1:-}" in
  install)
    require_identity
    cargo build --release --locked --package app
    # Signed in place before the copy, so a failed signature leaves the installed binary alone.
    built=target/release/music-recommender
    codesign --force --sign "$signing_identity" --identifier "$signing_identifier" "$built"
    codesign --verify --strict "$built"
    mkdir -p "$bin_dir" "$log_dir"
    install -m 0755 "$built" "$binary"
    if loaded; then unload; fi
    mkdir -p "$(dirname "$plist_path")"
    plist "$binary" "$log_file" > "$plist_path"
    launchctl bootstrap "$domain" "$plist_path"
    echo "✓ loaded $label; logs in $log_file"
    ;;
  uninstall)
    if loaded; then unload; else echo "$label is not loaded"; fi
    rm -f "$plist_path"
    echo "✓ removed $plist_path"
    ;;
  status)
    launchctl print "$domain/$label"
    ;;
  plist)
    plist "$binary" "$log_file"
    ;;
  *)
    echo "usage: ./scripts/agent install|uninstall|status|plist" >&2
    exit 2
    ;;
esac
